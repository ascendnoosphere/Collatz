Finite functional-graph cohomology with genuine weak components and incidence maps.
-/
import Mathlib.Logic.Relation
import Mathlib.Data.Fintype.EquivFin
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.Tactic.Abel
import Lean.Elab.Tactic.Omega

namespace GeneralizedCollatz.ComplexGraph

variable {V K : Type*} [Field K]

/-- Weak connectivity is generated by actual successor edges, with both directions retained. -/
def ComponentSetoid (T : V → V) : Setoid V :=
  Relation.EqvGen.setoid (fun v w => T v = w)

/-- Components are equivalence classes of vertices, not an assumed cycle count. -/
abbrev Components (T : V → V) := Quotient (ComponentSetoid T)

/-- Each vertex retains its actual weak-component class. -/
def ComponentClass (T : V → V) (v : V) : Components T :=
  Quotient.mk (ComponentSetoid T) v

/-- A successor edge cannot change its weak-component class. -/
theorem ComponentNext (T : V → V) (v : V) :
    ComponentClass T (T v) = ComponentClass T v := by
  exact (Quotient.sound (Relation.EqvGen.rel v (T v) rfl)).symm

/-- The finite vertex quotient has an explicit finite-cardinality interface. -/
noncomputable instance ComponentFinite (T : V → V) [Fintype V] : Fintype (Components T) :=
  Fintype.ofFinite (Components T)

/-- There is one oriented edge per vertex, including self-loops and incoming tree edges. -/
def Differential (T : V → V) : (V → K) →ₗ[K] (V → K) where
  toFun f v := f (T v) - f v
  map_add' f g := by
    ext v
    simp only [Pi.add_apply]
    abel
  map_smul' r f := by
    ext v
    simp only [Pi.smul_apply, smul_sub, RingHom.id_apply]

/-- Kernel membership is exactly constancy across every declared successor edge. -/
theorem KernelIff (T : V → V) (f : V → K) :
    f ∈ (Differential T).ker ↔ ∀ v, f (T v) = f v := by
  rw [LinearMap.mem_ker]
  constructor
  · intro h v
    exact sub_eq_zero.mp (congrFun h v)
  · intro h
    ext v
    exact sub_eq_zero.mpr (h v)

/-- Constancy on edges propagates through the entire generated equivalence relation. -/
theorem KernelRespects (T : V → V) (f : (Differential (K := K) T).ker)
    {v w : V} (h : (ComponentSetoid T).r v w) : f.1 v = f.1 w := by
  have he : ∀ x, f.1 (T x) = f.1 x := (KernelIff T f.1).mp f.property
  induction h with
  | rel v w h => { exact (he v).symm.trans (congrArg f.1 h) }
  | refl v => { rfl }
  | symm v w _ ih => { exact ih.symm }
  | trans v w x _ _ ihvw ihwx => { exact ihvw.trans ihwx }

/-- Zeroth cohomology is exactly one freely chosen coefficient on each real component. -/
def ComponentKernelEquiv (T : V → V) :
    (Differential (K := K) T).ker ≃ₗ[K] (Components T → K) where
  toFun f := Quotient.lift (fun v => f.1 v) (fun _ _ h => KernelRespects T f h)
  invFun a := ⟨fun v => a (ComponentClass T v), (KernelIff T _).mpr
    (fun v => congrArg a (ComponentNext T v))⟩
  left_inv f := by
    apply Subtype.ext
    funext v
    rfl
  right_inv a := by
    funext c
    refine Quotient.inductionOn c ?_
    intro v
    rfl
  map_add' f g := by
    funext c
    refine Quotient.inductionOn c ?_
    intro v
    rfl
  map_smul' r f := by
    funext c
    refine Quotient.inductionOn c ?_
    intro v
    rfl

/-- First cohomology is the actual incidence cokernel, not a named component counter. -/
abbrev FirstGraphCohomology (T : V → V) :=
  (V → K) ⧸ (Differential (K := K) T).range

/-- Every finite functional graph has one independent constant per weak component. -/
theorem GraphH0Dimension (T : V → V) [Fintype V] :
    Module.finrank K (Differential (K := K) T).ker = Fintype.card (Components T) := by
  rw [(ComponentKernelEquiv (K := K) T).finrank_eq, Module.finrank_fintype_fun_eq_card]

/-- Rank-nullity computes the complete incidence rank in every field characteristic. -/
theorem GraphIncidenceRank (T : V → V) [Fintype V] :
    Module.finrank K (Differential (K := K) T).range =
      Fintype.card V - Fintype.card (Components T) := by
  have h := LinearMap.finrank_range_add_finrank_ker (Differential (K := K) T)
  rw [GraphH0Dimension, Module.finrank_fintype_fun_eq_card] at h
  omega

/-- Equal numbers of vertex and edge cochains give H1 one dimension per component. -/
theorem GraphH1Dimension (T : V → V) [Fintype V] :
    Module.finrank K (FirstGraphCohomology (K := K) T) =
      Fintype.card (Components T) := by
  have hr := LinearMap.finrank_range_add_finrank_ker (Differential (K := K) T)
  have hq := (Differential (K := K) T).range.finrank_quotient_add_finrank
  rw [GraphH0Dimension] at hr
  change Module.finrank K (FirstGraphCohomology (K := K) T) +
    Module.finrank K (Differential (K := K) T).range = Module.finrank K (V → K) at hq
  omega

end GeneralizedCollatz.ComplexGraph
